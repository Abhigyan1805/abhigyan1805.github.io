---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
---

<Base title="Page not found" path="404/">
  <div class="wrap missing">
    <h1>This page is not here.</h1>
    <p>The link may be old or mistyped. The <a href={url()}>home page</a> lists all of the work.</p>
  </div>
</Base>

<style>
  .missing {
    padding-block: clamp(4rem, 14vw, 10rem);
  }
  h1 {
    font-size: var(--step-4);
    font-stretch: 118%;
  }
  p {
    margin-top: 1rem;
  }
</style>
