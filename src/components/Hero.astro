---
import { profile } from '../content/site';
import { url } from '../lib/url';

const [first, ...rest] = profile.name.split(' ');
---

<section class="hero" data-wave-host aria-labelledby="hero-name">
  <canvas class="field" aria-hidden="true" data-wave></canvas>
  <div class="wrap inner">
    <h1 id="hero-name" class="name">
      <span>{first}</span>
      <span>{rest.join(' ')}</span>
    </h1>
    <div class="lede">
      <p class="headline">{profile.headline}</p>
      <p class="intro">{profile.intro}</p>
      <ul class="link-row">
        <li><a href={`${url()}#work`}>See selected work</a></li>
        <li><a href={`mailto:${profile.email}`}>Email me</a></li>
        <li><a href={profile.links.github}>GitHub</a></li>
        <li><a href={profile.links.linkedin}>LinkedIn</a></li>
      </ul>
    </div>
    <p class="caption">
      <span class="eq math" aria-label="psi of r and t equals the sum over sources of cos of k r minus omega t, over root r">
        ψ(r, t) = Σ cos(kr<sub>i</sub> − ωt + φ<sub>i</sub>) / √r<sub>i</sub>
      </span>
      <span class="hint">
        Six sources with a sweeping phase gradient steer a beam, the job a metasurface does.
        <span class="hint-pointer">Move your pointer to add a seventh.</span>
        <span class="hint-touch">Tap to add a seventh.</span>
      </span>
    </p>
  </div>
</section>

<script>
  import { startWaveField } from '../scripts/wave-field';

  const canvas = document.querySelector<HTMLCanvasElement>('[data-wave]');
  if (canvas) {
    const start = () => startWaveField(canvas);
    if ('requestIdleCallback' in window) requestIdleCallback(start, { timeout: 800 });
    else setTimeout(start, 200);
  }
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    min-height: min(92svh, 920px);
    display: flex;
    align-items: flex-end;
    padding-block: clamp(5rem, 14vh, 9rem) clamp(2rem, 5vh, 3.5rem);
    overflow: hidden;
  }
  .field {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    background: var(--paper);
    opacity: 0;
    /* Fade the field out towards the text so contrast never depends on it. */
    -webkit-mask-image: linear-gradient(100deg, transparent 22%, #000 68%);
    mask-image: linear-gradient(100deg, transparent 22%, #000 68%);
  }
  .field[data-ready] {
    opacity: 1;
  }
  @media (prefers-reduced-motion: no-preference) {
    .field {
      transition: opacity 1.2s ease-out;
    }
  }

  .inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
  }
  .name {
    font-size: var(--display);
    font-weight: 700;
    font-stretch: 125%;
    line-height: 0.92;
    letter-spacing: -0.035em;
    text-wrap: initial;
  }
  .name span {
    display: block;
    white-space: nowrap;
  }
  .name span:last-child {
    font-weight: 380;
    color: var(--prussian);
  }
  .lede {
    max-width: 40rem;
  }
  .headline {
    font-size: var(--step-2);
    font-weight: 560;
    font-stretch: 108%;
    line-height: 1.25;
    max-width: 30ch;
  }
  .intro {
    margin-top: 1rem;
    color: var(--muted);
    max-width: 58ch;
  }
  .link-row {
    margin-top: 1.5rem;
  }
  .caption {
    display: grid;
    gap: 0.35rem;
    max-width: 34rem;
    justify-self: start;
    padding: 0.75rem 1rem;
    margin-inline: -1rem;
    background: color-mix(in srgb, var(--paper) 90%, transparent);
    border-radius: 4px;
    color: var(--muted);
    font-size: var(--step--1);
  }
  .eq {
    color: var(--ink);
    font-size: 1.15rem;
  }
  .eq sub {
    font-size: 0.7em;
  }
  .hint-touch {
    display: none;
  }
  @media (hover: none) {
    .hint-pointer {
      display: none;
    }
    .hint-touch {
      display: inline;
    }
  }

  @media (min-width: 1000px) {
    .inner {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: end;
      column-gap: 2.5rem;
    }
    .name {
      grid-column: 1 / -1;
    }
    .caption {
      justify-self: end;
      text-align: right;
    }
  }

  @media (max-width: 699px) {
    .hero {
      min-height: auto;
      padding-top: 46vw;
    }
    .field {
      -webkit-mask-image: linear-gradient(180deg, #000 12%, transparent 50%);
      mask-image: linear-gradient(180deg, #000 12%, transparent 50%);
    }
  }
</style>
